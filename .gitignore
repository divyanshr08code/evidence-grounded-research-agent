# Environments
.venv/
venv/
env/
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Testing / linting / type-checking caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Logs and local data
*.log
.cache/

# IDE / editor
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Local corpus and generated run artifacts (indexes, embeddings, traces).
# Fixture corpora used by tests live under tests/fixtures/ and are tracked.
data/*
!data/.gitkeep
runs/*
!runs/.gitkeep

# Claude Code local/session configuration (machine-specific paths, this
# session's command approvals) -- not shared project config.
.claude/
